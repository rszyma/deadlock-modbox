# Adds a Play button to the ESC pause menu, like QOL Lock does.
#
# Clicking it opens the match launch (Play) page via CitadelShowPlayPage(),
# so you can queue without using the Hideout terminals. Useful when the
# Hideout crashes on join. Standalone alternative to QOL Lock and to the
# QoL Escape HUD mod (which adds Play+Watch+Listen) - this adds only Play.
#
# Layout: inserts a Playbtn panel before #changehero in hud_escape_menu.xml.
# Style: mirrors #changehero styling for #Playbtn, always visible, stacked
# above #changehero (margin-bottom 350px vs 280px).
--- a/panorama/layout/hud_escape_menu.xml
+++ b/panorama/layout/hud_escape_menu.xml
@@ -37,6 +37,9 @@
 						<Label text="#DevMenu_UnstickHero" class="menuButtonLabel" />
 					</Button>
 				</Panel>
+				<Button id="Playbtn" class="nav_menu_item primary" onactivate="CitadelShowPlayPage()">
+					<Label text="#menu_play" class="menuButtonLabel" />
+				</Button>
 				<Button id="changehero" class="nav_menu_item primary" onactivate="CitadelEscapeMenuChangeHero()">
 					<Label text="#menu_changehero" class="menuButtonLabel" />
 				</Button>
--- a/panorama/styles/hud_escape_menu.css
+++ b/panorama/styles/hud_escape_menu.css
@@ -329,7 +329,7 @@
 	transition-duration: 0s;
 }
 
-#changehero .MenuIcon
+#changehero .MenuIcon,#Playbtn .MenuIcon
 {
 	background-image: url("s2r://panorama/images/icons/hero_grid.vsvg");
 	width: 60px;
@@ -443,6 +443,16 @@
 	visibility: visible;
 }
 
+#Playbtn
+{
+	visibility: visible;
+	pre-transform-rotate2d: -1.7deg;
+	vertical-align: bottom;
+	margin-bottom: 350px;
+	opacity-mask: url("s2r://panorama/images/main_menu/text_speckle_mask_main_psd.vtex") 0.7;
+	opacity-mask-scale: 100% 200%;
+}
+
 #changehero
 {
 	visibility: collapse;
@@ -453,12 +463,12 @@
 	opacity-mask-scale: 100% 200%;
 }
 
-#changehero Label.menuButtonLabel
+#changehero Label.menuButtonLabel,#Playbtn Label.menuButtonLabel
 {
 	font-size: 60px;
 }
 
-#changehero:hover
+#changehero:hover,#Playbtn:hover
 {
 	pre-transform-rotate2d: -2.8deg;
 }
