# spec: diffmod/v1
# title: Always show ability suggestions
# decompiler: source2viewer-cli/20.1
#
# This mod makes the "recommended" ability upgrade label always show,
# if you have enough unspent ability points to upgrade the next ability from your build.
#
# Without this mod, it only shows this label after pressing ALT / showing "HUD detail view",
# which I found easy to miss and sit on tons of unspent points for too long.
--- a/panorama/styles/hud_ability_icon.css
+++ b/panorama/styles/hud_ability_icon.css
@@ -193,7 +193,7 @@
 	ignore-parent-flow: true;
 }

-.gDetailView .build_suggestion .build_suggestion_container,.wants_scoreboard .build_suggestion .build_suggestion_container
+.build_suggestion .build_suggestion_container
 {
 	visibility: visible;
 }
