# Mouse back button cancels the imbue dialog.
#
# Pressing the mouse back button (mouse4) while the imbue or
# ability-select dialog is open cancels it, exactly like ESC.
# Capture happens below the game keybinds: panorama's own keybind
# file routes mouse4 to Cancelled for popups, so the game never
# sees it as a game key first. No settings changes needed.
#
--- a/panorama/citadel_keybinds.cfg
+++ b/panorama/citadel_keybinds.cfg
@@ -1,4 +1,5 @@
 Citadel_dashboard#mouse_4 CitadelNavigateBack
-popup#mouse_4 None
+popup#mouse_4 Cancelled
 Citadel_dashboard#mouse_5 CitadelNavigateForward
-popup#mouse_5 None
\ No newline at end of file
+popup#mouse_5 None
+mouse_4 Cancelled
\ No newline at end of file
